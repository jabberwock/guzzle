{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Guzzle",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    { "identifier": "fs:allow-read-text-file", "allow": [{ "path": "**" }] },
    { "identifier": "fs:allow-read-file",      "allow": [{ "path": "**" }] },
    { "identifier": "fs:allow-read-dir",       "allow": [{ "path": "**" }] },
    { "identifier": "fs:allow-exists",         "allow": [{ "path": "**" }] },
    {
      "identifier": "shell:allow-open",
      "allow": [{ "url": "**" }]
    }
  ]
}
